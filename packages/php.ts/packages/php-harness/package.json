{
    "name": "@nyar/php-harness",
    "version": "0.0.1",
    "description": "PHP diagnostics and tuning harness over @nyar/php",
    "type": "module",
    "license": "MPL-2.0",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli.js"
    },
    "bin": {
        "php-harness": "bin/php-harness.mjs"
    },
    "files": [
        "bin",
        "dist",
        "src",
        "locales",
        "readme.md"
    ],
    "dependencies": {
        "@nyar/php": "workspace:*",
        "@vmz/commander": "^0.3.18"
    },
    "optionalDependencies": {
        "@nyar/php-darwin-arm64": "workspace:*",
        "@nyar/php-darwin-x64": "workspace:*",
        "@nyar/php-linux-x64": "workspace:*",
        "@nyar/php-win32-x64": "workspace:*"
    },
    "scripts": {
        "build": "node ../../../../scripts/build-npm-package-js.mjs packages/php.ts/packages/php-harness",
        "prepack": "node ../../../../scripts/build-npm-package-js.mjs packages/php.ts/packages/php-harness && node ../../../../scripts/prepare-npm-publish.mjs"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "keywords": ["php", "harness", "diagnostics", "tuning"],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-vm/php.git",
        "directory": "packages/php.ts/packages/php-harness"
    },
    "publishConfig": {
        "access": "public"
    }
}
